    "version": "0.2.0",
    "configurations": [
      {
        "name": "production",
        "request": "launch",
        "type": "dart",
        "flutterMode": "debug",
        "args": ["--flavor", "production"],
        "toolArgs": ["--dart-define-from-file", ".env.production"]
      },
      {
        "name": "staging",
        "request": "launch",
        "type": "dart",
        "flutterMode": "debug",
        "args": ["--flavor", "staging"],
        "toolArgs": ["--dart-define-from-file", ".env.staging"]
      },
      {
        "name": "production release",
        "request": "launch",
        "type": "dart",
        "flutterMode": "release",
        "args": ["--flavor", "production"],
        "toolArgs": ["--dart-define-from-file", ".env.production"]
      },
      {
        "name": "staging release",
        "request": "launch",
        "type": "dart",
        "flutterMode": "release",
        "args": ["--flavor", "staging"],
        "toolArgs": ["--dart-define-from-file", ".env.staging"]
      },
    ]
  }
  